{
  "format": "robot_pipeline.capture.profile.v1",
  "backend": "unitree",
  "mode": "simulation",
  "label": "G1 + Dex3 仿真采集启动示例（红块）",
  "xr_repo": "/opt/robot/xr_teleoperate",
  "python": "/opt/robot/tv/bin/python",
  "output_root": "/data/robot/raw/simulation",
  "arm": "G1_29",
  "ee": "dex3",
  "network_interface": "lo",
  "image_server_ip": "127.0.0.1",
  "frequency": 30,
  "headless": true,
  "scene_task": "Isaac-PickPlace-RedBlock-G129-Dex3-Joint",
  "services": [
    {
      "id": "simulation",
      "label": "Isaac Lab 仿真与图像服务",
      "manage": "launch",
      "transport": "local",
      "argv": [
        "/opt/robot/isaac-env/bin/python",
        "/opt/robot/unitree_sim_isaaclab/sim_main.py",
        "--device",
        "cpu",
        "--enable_cameras",
        "--task",
        "Isaac-PickPlace-RedBlock-G129-Dex3-Joint",
        "--enable_dex3_dds",
        "--robot_type",
        "g129",
        "--headless"
      ],
      "cwd": "/opt/robot/unitree_sim_isaaclab",
      "probe": {
        "host": "127.0.0.1",
        "port": 55555
      },
      "startup_timeout": 600
    }
  ]
}
